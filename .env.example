# 可选：设为 true 时，v2 开发页改用本机 /local-model 兼容接口
VITE_USE_LOCAL_MODEL=false

# 仅放在 Vercel 或 vercel dev 的服务端环境中；不要加 VITE_，不要提交真实值。
OPENAI_API_KEY=
# OpenAI 官方地址为 https://api.openai.com/v1；公司兼容网关请填写其 /v1 地址
OPENAI_BASE_URL=https://api.openai.com/v1
# responses 或 chat_completions
OPENAI_API_MODE=responses
# 单模型配置；设置后优先于 OPENAI_MODELS
OPENAI_MODEL=
# 可选：逗号分隔的回退列表；OPENAI_MODEL 为空时使用
OPENAI_MODELS=
# 可选：启用 /api/models 诊断接口；请求时使用 Authorization: Bearer <token>
OPENAI_MODELS_DEBUG_TOKEN=
